.queens-game data-controller="queens"
  h1 Queens
  p Place exactly one crown per row, column, and region. Crowns cannot touch each other.
  
  .queens-board
    - @grid.size.times do |r|
      .queens-row
        - @grid.size.times do |c|
          - cell = @grid.cell_at(r, c)
          - color_class = "region-#{cell.region_id % 8}"
          .queens-cell class=color_class data-row=r data-col=c data-action="click->queens#toggleCell" data-queens-target="cell" data-region=cell.region_id
            span.queens-symbol

  div style="margin-top: 1rem;"
    button.button data-action="click->queens#validate" Check Rules
    a.button href="/queens?random=true" style="margin-left: 1rem; background-color: #555;" New Random Puzzle
    span data-queens-target="status" style="margin-left: 1rem; font-weight: bold;"
