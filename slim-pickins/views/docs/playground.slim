= ui_card "Interactive Playground"
  / sp-playground is the demo's own controller, not framework behaviour.
  .sp-playground data-controller="sp-playground" data-sp-playground-url-value="/docs/render"
    .sp-cluster.sp-cluster--loose.sp-cluster--start
      .sp-grow
        h4 Source (Slim/Ruby)
        textarea.sp-input.sp-input--code data-sp-playground-target="input" data-action="input->sp-playground#render" rows="15"
          | / Try editing this!
            = ui_card "Playground Card"
              p This is rendered live.
              = ui_button "Click Me", :primary, onclick: "alert('It works!')"

      .sp-grow
        h4 Live Preview
        .sp-well.sp-well--tall.sp-well--strong data-sp-playground-target="output"
