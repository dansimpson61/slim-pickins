= ui_card "System Status"

  h3 Core Routes
  ul.sp-list
    ruby:
      routes = [
        "/",
        "/docs",
        "/docs/playground",
        "/docs/quickstart",
        "/docs/button",
        "/docs/card",
        "/docs/flash",
        "/docs/form",
        "/docs/list",
        "/docs/toggle",
        "/status"
      ]

    - routes.each do |route|
      li.sp-list__item
        = ui_toggle_panel do
          / Starts pending; the script below settles it to ok or danger.
          = ui_summary do
            = ui_badge "?", :pending, class: "sp-status-icon", "data-route": route
            span Route: #{route}
          .sp-cluster.sp-inset
            a.sp-btn.sp-btn--primary href=route target="_blank" Open Link
            code.sp-text-muted = route

  javascript:
    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll(".sp-status-icon").forEach(icon => {
        const settle = (variant, char) => {
          icon.classList.remove("sp-badge--pending");
          icon.classList.add(`sp-badge--${variant}`);
          icon.textContent = char;
        };

        fetch(icon.dataset.route)
          .then(response => settle(response.ok ? "ok" : "danger", response.ok ? "✓" : "✗"))
          .catch(() => settle("danger", "!"));
      });
    });

  h3 Component Completeness
  p.sp-text-muted A component declares its own name; this asks whether its appearance and behaviour are actually present. Rendering without raising is not the same as being finished.

  ul.sp-list
    ruby:
      audited = SlimPickins::Component.registry.sort_by(&:slug)
      incomplete = SlimPickins.audit.to_h { |r| [r[:component], r[:missing]] }

    - audited.each do |component|
      - missing = incomplete[component]
      li.sp-list__item
        = ui_badge(missing ? "✗" : "✓", missing ? :danger : :ok)
        .sp-cluster.sp-cluster--tight
          strong = component.slug
          span.sp-text-muted
            - if missing
              = "missing #{missing.join(', ')}"
            - else
              = "#{component.stylesheet}#{component.behaviour ? " + #{component.behaviour}" : ''}"

  h3 Helper Functionality Checks
  ul.sp-list
    ruby:
      checks = {
        "ui_button" => -> { ui_button("Test Button", :primary) },
        "ui_card" => -> { ui_card("Test Card") { "Card Content" } },
        "ui_flash" => -> { ui_flash(:info, "Flash Message") },
        "ui_sortable_list" => -> { ui_sortable_list(url: "#") { ui_sortable_item(1) { "List Item" } } },
        "ui_text_field" => -> { ui_text_field("test_field", "Editable Value", url: "#") },
        "ui_toggle_panel" => -> { ui_toggle_panel("Test Toggle") { "Hidden Content" } },
        "ui_table" => -> { ui_table(["A", "B"], [["1", "2"]]) },
        "ui_code" => -> { ui_code('= ui_button "Save"') },
        "ui_well" => -> { ui_well { "Inset content" } },
        "ui_badge" => -> { ui_badge("✓", :ok) },
        "ui_money" => -> { ui_money(-6_400) }
      }

    - checks.each do |name, check|
      ruby:
        status = :passed
        error_message = nil
        rendered_html = ""
        begin
          rendered_html = check.call
        rescue => e
          status = :failed
          error_message = e.message
        end

        icon_char = status == :passed ? "✓" : "✗"
        variant = status == :passed ? :ok : :danger
        text_status = status == :failed ? "Error: #{error_message}" : "OK"

      li.sp-list__item
        = ui_toggle_panel do
          = ui_summary do
            = ui_badge icon_char, variant
            .sp-cluster.sp-cluster--tight
              strong = name
              span.sp-text-muted = text_status

          h4 Live Preview
          = ui_well do
            = rendered_html

          h4 Source HTML
          = ui_code rendered_html
