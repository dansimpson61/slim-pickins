== ui_card "System Status"

  h3 Core Routes
  ul.sp-sortable-list
    ruby:
      routes = [
        "/",
        "/docs",
        "/docs/playground",
        "/docs/quickstart",
        "/docs/button",
        "/docs/card",
        "/docs/flash",
        "/docs/form",
        "/docs/list",
        "/docs/toggle",
        "/status"
      ]

    - routes.each do |route|
      li.sp-sortable-item
        / Starts pending; the script below settles it to ok or danger.
        - title = ui_badge("?", :pending, class: "sp-status-icon", "data-route": route) + sp_tag(:span, "Route: #{route}")
        == ui_toggle_panel title do
          .sp-cluster.sp-inset
            a.sp-btn.sp-btn--primary href=route target="_blank" Open Link
            code.sp-text-muted = route

  javascript:
    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll(".sp-status-icon").forEach(icon => {
        const settle = (variant, char) => {
          icon.classList.remove("sp-badge--pending");
          icon.classList.add(`sp-badge--${variant}`);
          icon.textContent = char;
        };

        fetch(icon.dataset.route)
          .then(response => settle(response.ok ? "ok" : "danger", response.ok ? "✓" : "✗"))
          .catch(() => settle("danger", "!"));
      });
    });

  h3 Helper Functionality Checks
  ul.sp-sortable-list
    ruby:
      checks = {
        "ui_button" => -> { ui_button("Test Button", :primary) },
        "ui_card" => -> { ui_card("Test Card") { "Card Content" } },
        "ui_flash" => -> { ui_flash(:info, "Flash Message") },
        "ui_sortable_list" => -> { ui_sortable_list(url: "#") { ui_sortable_item(1) { "List Item" } } },
        "ui_text_field" => -> { ui_text_field("test_field", "Editable Value", url: "#") },
        "ui_toggle_panel" => -> { ui_toggle_panel("Test Toggle") { "Hidden Content" } },
        "ui_table" => -> { ui_table(["A", "B"], [["1", "2"]]) },
        "ui_code" => -> { ui_code('== ui_button "Save"') },
        "ui_well" => -> { ui_well { "Inset content" } },
        "ui_badge" => -> { ui_badge("✓", :ok) }
      }

    - checks.each do |name, check|
      ruby:
        status = :passed
        error_message = nil
        rendered_html = ""
        begin
          rendered_html = check.call
        rescue => e
          status = :failed
          error_message = e.message
        end

        icon_char = status == :passed ? "✓" : "✗"
        variant = status == :passed ? :ok : :danger
        text_status = status == :failed ? "Error: #{error_message}" : "OK"

        label = sp_tag(:strong, name) + sp_tag(:span, text_status, class: "sp-text-muted")
        title = ui_badge(icon_char, variant) + sp_tag(:div, label, class: "sp-cluster sp-cluster--tight")

      li.sp-sortable-item
        == ui_toggle_panel title do
          h4 Live Preview
          == ui_well do
            == rendered_html

          h4 Source HTML
          == ui_code rendered_html
