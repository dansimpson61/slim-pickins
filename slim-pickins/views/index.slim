/ 1. Flash Messages
== ui_flash :notice, "Welcome to the Modest MVP!"

/ 2. Cards & Structure
== ui_card "My Todo List"
  p.text-muted This is a card component.
  
  / 3. Toggle Panel (Details/Summary)
  == ui_toggle_panel "Show Instructions"
    p Drag items to reorder. Click text to edit.

  / 4. Sortable List
  == ui_sortable_list url: "/todos/sort"
    - @todos.each do |todo|
      == ui_sortable_item todo[:id] do
        
        / Grip Handle (Implicit or explicit)
        / span.sp-handle ☰
        
        / 5. Edit-in-Place Field (Grows to fill space)
        == ui_text_field "title", todo[:title], url: "/todos/#{todo[:id]}"
        
        / 6. Actions (Reveal on hover)
        .sp-actions.sp-cluster
          == ui_button ui_icon(:trash, class: "sp-icon--sm"), :danger, class: "sp-btn--sm sp-btn--icon", title: "Delete", data: { controller: "sp-remove", action: "click->sp-remove#delete" }

/ 7. Buttons
.sp-stack
  h3 Buttons
  .sp-cluster
    == ui_button "Primary Action", :primary, onclick: "showToast('Primary action executed successfully!', 'primary')"
    == ui_button "Secondary", :neutral, onclick: "showToast('Secondary action clicked.', 'neutral')"
    == ui_button "Danger Zone", :danger, onclick: "showToast('Critical system error simulated.', 'danger')"
