.sp-page.sp-page--wide data-controller="withdrawal-form"
  / Header Section
  .sp-masthead
    div
      .sp-cluster
        span.sp-overline Today's Portfolio Value
        form action="/" method="get" data-controller="auto-submit"
          select.sp-input.sp-input--auto name="portfolio_id" data-action="change->auto-submit#submit"
            - @portfolios.each do |p|
              option value="#{p['id']}" selected=(p['id'] == @portfolio['id']) = p['name']

      .sp-figure.sp-figure--lg
        = ui_money @portfolio['balance']

    / Sustainability Monitor (Visual Placeholder)
    .sp-stack.sp-stack--tight
      span.sp-overline Sustainability Outlook
      .sp-cluster
        / Placeholder: the fill width is fixed in CSS until this is real data.
        .sp-meter
          .sp-meter__fill
        span.sp-text-sm.sp-text-muted On Track

  / River of Wealth Chart
  = ui_card "River of Wealth" do
    - if @portfolio_accounts.empty?
      p.sp-text-muted
        | This portfolio has no accounts, so there is nothing to project.
        a href="/portfolios/manage"  Add some on the Portfolios page.
    - else
      .sp-chart data-controller="river-chart"
        canvas data-river-chart-target="canvas"

  / Recent Movements & Action
  .sp-cluster.sp-cluster--between
    h3 Recent & Upcoming Movements
    = ui_modal_trigger "+ Add Event", dialog: "add-withdrawal-modal", data: { action: "click->sp-modal#open click->withdrawal-form#reset" }

  = ui_card do
    movements
      Description
      Amount
      Actions

  / Add Withdrawal Modal
  = ui_modal id: "add-withdrawal-modal", title: "Add Portfolio Event" do
    form data-withdrawal-form-target="form" data-action="submit->withdrawal-form#submit"
      input type="hidden" name="id" data-withdrawal-form-target="id"

      = ui_field "Description" do
        input.sp-input type="text" name="description" placeholder="e.g., Living Expenses" data-withdrawal-form-target="description" required=""

      = ui_field "Amount (Gross)" do
        input.sp-input type="number" name="amount" placeholder="0.00" step="0.01" data-withdrawal-form-target="amount" data-action="input->withdrawal-form#calculate" required=""

      .sp-grid.sp-grid--2
        = ui_field "Date" do
          input.sp-input type="date" name="date" data-withdrawal-form-target="date" required=""

        = ui_field "Frequency" do
          select.sp-input name="frequency"
            option value="one_time" One-time
            option value="monthly" Monthly
            option value="yearly" Yearly

      = ui_well do
        .sp-cluster.sp-cluster--between
          label.sp-label Taxable Event?
          input type="checkbox" name="is_taxable" data-withdrawal-form-target="isTaxable" data-action="change->withdrawal-form#toggleTax" checked=""

        div data-withdrawal-form-target="taxFields"
          .sp-grid.sp-grid--2
            = ui_field "Federal Tax %" do
              input.sp-input type="number" name="federal_tax_rate" value="20" data-withdrawal-form-target="fedRate" data-action="input->withdrawal-form#calculate"
              .sp-note data-withdrawal-form-target="fedFeedback" Est. Fed Tax: $0.00

            = ui_field "State Tax %" do
              input.sp-input type="number" name="state_tax_rate" value="5" data-withdrawal-form-target="stateRate" data-action="input->withdrawal-form#calculate"
              .sp-note data-withdrawal-form-target="stateFeedback" Est. State Tax: $0.00

      .sp-stack.sp-stack--tight.sp-text-center
        .sp-text-sm.sp-text-muted Estimated Net Withdrawal
        .sp-text-accent.sp-figure.sp-figure--sm data-withdrawal-form-target="netResult" $0.00

      .sp-cluster.sp-cluster--end
        = ui_button "Cancel", :neutral, type: "button", class: "sp-btn--ghost", data: { action: "click->sp-modal#close" }
        = ui_button "Save Event", :primary, type: "submit"
