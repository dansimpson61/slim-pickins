.container.sp-page--wide data-controller="valuation"
  .dashboard-header
    h1 Accounts Management
    / Toggle Archived
    form action="/accounts" method="get"
      label.sp-cluster.sp-text-sm.sp-text-muted
        input type="checkbox" name="show_archived" value="true" checked=(params[:show_archived]=='true') onchange="this.form.submit()"
        | Show Archived Accounts

  / Create Account
  = ui_card "Create New Account" do
    form.sp-cluster.sp-cluster--end data-controller="account-create" data-action="submit->account-create#submit"
      = ui_field "Name", class: "sp-field-group--flush sp-grow" do
        input.sp-input type="text" placeholder="e.g. Robinhood, Wells Fargo" data-account-create-target="name" required=""
      = ui_field "Type", class: "sp-field-group--flush" do
        select.sp-input data-account-create-target="type"
          option value="asset" Asset
          option value="liability" Liability
          option value="income" Income
          option value="expense" Expense
          option value="external" External
      = ui_button "Create", :primary, type: "submit"

  = ui_card do
    accounts
      Name
      Type
      Balance
      Actions

  / Valuation Modal
  = ui_modal title: "Update Market Value", data: { valuation_target: "modal" } do
    form data-action="submit->valuation#submit"
      input type="hidden" data-valuation-target="id"

      .sp-stack.sp-stack--tight
        p.sp-text-muted Updating value for:
        h2 data-valuation-target="name" Main Portfolio
        p.sp-text-sm.sp-text-muted
          | Current Balance:
          span data-valuation-target="currentBalance" $0.00

      = ui_field "Date of Valuation" do
        input.sp-input type="date" data-valuation-target="date" required=""

      = ui_field "New Market Value" do
        input.sp-input type="number" step="0.01" data-valuation-target="value" required=""
        p.sp-text-sm.sp-text-muted The system will automatically generate an adjustment flow.

      .sp-cluster.sp-cluster--end
        = ui_button "Cancel", :neutral, type: "button", class: "sp-btn--ghost", data: { action: "click->valuation#close" }
        = ui_button "Update Value", :primary, type: "submit"
